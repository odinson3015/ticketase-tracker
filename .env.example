# Postgres connection string.
# From Vercel: Storage tab -> your Postgres database -> ".env.local" tab -> copy POSTGRES_PRISMA_URL
# Locally you can point this at any Postgres instance (e.g. a free Neon or Supabase database).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
# Your deployed URL in production (e.g. https://ticketase-tracker.vercel.app). http://localhost:3000 for local dev.
NEXTAUTH_URL="http://localhost:3000"

# Anyone signing up on /register must enter this code. Share it only with your team.
# Pick your own value before deploying.
TEAM_INVITE_CODE="reachout-team-2026"

# ---- Email notifications (optional) ----
# From resend.com -> API Keys. If this is missing, notification emails are simply off.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# Must use a domain you verified in Resend.
EMAIL_FROM="Ticketase Tracker <tracker@notify.ticketase.com>"
# Your live site, used for the links inside emails. No trailing slash.
APP_URL="https://your-project.vercel.app"
