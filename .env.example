# Postgres connection string.
# From Vercel: Storage tab -> your Postgres database -> ".env.local" tab -> copy POSTGRES_PRISMA_URL
# Locally you can point this at any Postgres instance (e.g. a free Neon or Supabase database).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
# Your deployed URL in production (e.g. https://ticketase-tracker.vercel.app). http://localhost:3000 for local dev.
NEXTAUTH_URL="http://localhost:3000"

# Anyone signing up on /register must enter this code. Share it only with your team.
# Pick your own value before deploying.
TEAM_INVITE_CODE="reachout-team-2026"
